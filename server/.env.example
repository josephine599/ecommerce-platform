# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/ecommerce

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_SHORTCODE=174379

# Enable TEST MODE (set to "true" to use mock responses without real M-Pesa credentials)
# When TEST_MODE=true, payments will return mock success responses for testing
MPESA_TEST_MODE=true

# Callback URL (for production: https://your-domain.com)
CALLBACK_URL=http://localhost:5000

# Port
PORT=5000

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Node Environment
NODE_ENV=development

